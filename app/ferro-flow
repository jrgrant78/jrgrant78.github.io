<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Ferro-Flow: Magnetic Fluid Logic</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; user-select: none; -webkit-user-select: none; }
        body {
            background-color: #050608;
            color: #e0e6ed;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
        }
        #game-container {
            position: relative;
            width: 100vw;
            max-width: 440px;
            height: 100vh;
            max-height: 800px;
            background: #090b10;
            display: flex;
            flex-direction: column;
            box-shadow: 0 12px 40px rgba(0,0,0,0.8);
            border-radius: 16px;
            overflow: hidden;
            border: 1px solid rgba(255,255,255,0.05);
        }
        canvas {
            flex: 1;
            width: 100%;
            height: 100%;
            touch-action: none;
            cursor: pointer;
        }
        .ui-overlay {
            position: absolute;
            top: 0; left: 0; right: 0;
            padding: 20px;
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            pointer-events: none;
            z-index: 10;
        }
        .ui-element { pointer-events: auto; }
        .level-title { font-size: 1.1rem; font-weight: 800; letter-spacing: 1.5px; color: #fff; }
        .level-sub { font-size: 0.75rem; color: #64748b; margin-top: 2px; }
        .btn {
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.12);
            color: #e2e8f0;
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
            cursor: pointer;
            backdrop-filter: blur(8px);
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .btn:hover { background: rgba(255, 255, 255, 0.15); transform: translateY(-1px); }
        .btn:active { transform: translateY(0); }
        
        .win-modal {
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(9, 11, 16, 0.88);
            backdrop-filter: blur(12px);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 20;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.4s ease, transform 0.4s ease;
            transform: scale(1.05);
        }
        .win-modal.active { opacity: 1; pointer-events: auto; transform: scale(1); }
        .win-modal h2 { font-size: 1.8rem; font-weight: 800; color: #00f0ff; letter-spacing: 2px; margin-bottom: 6px; text-shadow: 0 0 16px rgba(0,240,255,0.4); }
        .win-modal p { font-size: 0.88rem; color: #94a3b8; margin-bottom: 28px; text-align: center; max-width: 75%; line-height: 1.4; }
        
        .legend {
            position: absolute;
            bottom: 14px; left: 0; right: 0;
            display: flex;
            justify-content: center;
            gap: 18px;
            font-size: 0.7rem;
            font-weight: 600;
            color: #64748b;
            pointer-events: none;
            letter-spacing: 0.5px;
        }
        .legend-item { display: flex; align-items: center; gap: 6px; }
        .dot { width: 8px; height: 8px; border-radius: 50%; }
    </style>
</head>
<body>

<div id="game-container">
    <div class="ui-overlay">
        <div>
            <div class="level-title" id="level-title">LEVEL 1</div>
            <div class="level-sub" id="level-desc">Tap nodes to toggle magnetic state</div>
        </div>
        <button class="btn ui-element" id="reset-btn">Reset</button>
    </div>

    <canvas id="canvas"></canvas>

    <div class="legend">
        <div class="legend-item"><div class="dot" style="background:#ff2a5f; box-shadow: 0 0 6px #ff2a5f"></div> Attract (+)</div>
        <div class="legend-item"><div class="dot" style="background:#00f0ff; box-shadow: 0 0 6px #00f0ff"></div> Repel (-)</div>
        <div class="legend-item"><div class="dot" style="background:#334155"></div> Off</div>
    </div>

    <div class="win-modal" id="win-modal">
        <h2>CONTAINMENT MET</h2>
        <p>Ferrofluid stabilized successfully into target trap.</p>
        <button class="btn" id="next-btn" style="padding: 12px 32px; font-size: 0.9rem; background: #00f0ff; color: #090b10; font-weight: 700; border: none; box-shadow: 0 0 20px rgba(0,240,255,0.4);">CONTINUE</button>
    </div>
</div>

<script>
const canvas = document.getElementById('canvas');
const ctx = canvas.getContext('2d');
const container = document.getElementById('game-container');
const levelTitle = document.getElementById('level-title');
const levelDesc = document.getElementById('level-desc');
const winModal = document.getElementById('win-modal');
const resetBtn = document.getElementById('reset-btn');
const nextBtn = document.getElementById('next-btn');

let width, height, dpr;
let currentLevelIdx = 0;
let particles = [];
let animFrameId = null;

// Node States: 0 = Neutral, 1 = Attract (Red), -1 = Repel (Cyan)
const STATE = { NEUTRAL: 0, ATTRACT: 1, REPEL: -1 };

const LEVELS = [
    {
        title: "LEVEL 1: FIELD CURVATURE",
        desc: "Tap the node to attract the ferrofluid stream",
        emitter: { x: 0.2, y: 0.15, rate: 3 },
        receiver: { x: 0.8, y: 0.8, r: 28, required: 80 },
        nodes: [{ x: 0.5, y: 0.45, r: 26, state: STATE.NEUTRAL }],
        walls: [{ x: 0.35, y: 0.6, w: 0.3, h: 0.02 }]
    },
    {
        title: "LEVEL 2: POLAR DEFLECTION",
        desc: "Guide fluid around the central barrier",
        emitter: { x: 0.5, y: 0.12, rate: 3 },
        receiver: { x: 0.5, y: 0.85, r: 28, required: 90 },
        nodes: [
            { x: 0.25, y: 0.35, r: 24, state: STATE.NEUTRAL },
            { x: 0.75, y: 0.55, r: 24, state: STATE.NEUTRAL }
        ],
        walls: [
            { x: 0.3, y: 0.45, w: 0.4, h: 0.02 }
        ]
    },
    {
        title: "LEVEL 3: VISCOSITY GATE",
        desc: "Slow down and compress fluid to pass through narrow gap",
        emitter: { x: 0.15, y: 0.15, rate: 4 },
        receiver: { x: 0.85, y: 0.85, r: 28, required: 100 },
        nodes: [
            { x: 0.35, y: 0.3, r: 22, state: STATE.NEUTRAL },
            { x: 0.5, y: 0.6, r: 22, state: STATE.NEUTRAL },
            { x: 0.7, y: 0.4, r: 22, state: STATE.NEUTRAL }
        ],
        walls: [
            { x: 0.0, y: 0.5, w: 0.42, h: 0.02 },
            { x: 0.58, y: 0.5, w: 0.42, h: 0.02 }
        ]
    },
    {
        title: "LEVEL 4: MAGNETIC CIRCUIT",
        desc: "Balance attraction and repulsion forces",
        emitter: { x: 0.5, y: 0.1, rate: 4 },
        receiver: { x: 0.2, y: 0.85, r: 28, required: 100 },
        nodes: [
            { x: 0.5, y: 0.3, r: 24, state: STATE.NEUTRAL },
            { x: 0.8, y: 0.5, r: 24, state: STATE.NEUTRAL },
            { x: 0.5, y: 0.7, r: 24, state: STATE.NEUTRAL }
        ],
        walls: [
            { x: 0.35, y: 0.45, w: 0.3, h: 0.02 },
            { x: 0.1, y: 0.65, w: 0.3, h: 0.02 }
        ]
    }
];

let state = {
    emitter: { x: 0, y: 0, rate: 3, timer: 0 },
    receiver: { x: 0, y: 0, r: 0, count: 0, required: 100 },
    nodes: [],
    walls: [],
    completed: false
};

function resize() {
    const rect = container.getBoundingClientRect();
    dpr = Math.min(window.devicePixelRatio || 1, 2);
    width = rect.width;
    height = rect.height;
    
    canvas.width = width * dpr;
    canvas.height = height * dpr;
    ctx.scale(dpr, dpr);
    
    loadLevel(currentLevelIdx);
}

function loadLevel(idx) {
    const template = LEVELS[idx];
    levelTitle.textContent = template.title;
    levelDesc.textContent = template.desc;
    winModal.classList.remove('active');
    
    particles = [];
    state.completed = false;
    
    state.emitter = {
        x: template.emitter.x * width,
        y: template.emitter.y * height,
        rate: template.emitter.rate,
        timer: 0
    };
    
    state.receiver = {
        x: template.receiver.x * width,
        y: template.receiver.y * height,
        r: template.receiver.r,
        count: 0,
        required: template.receiver.required
    };
    
    state.nodes = template.nodes.map(n => ({
        x: n.x * width,
        y: n.y * height,
        r: n.r,
        state: n.state,
        pulse: 0
    }));
    
    state.walls = template.walls.map(w => ({
        x: w.x * width,
        y: w.y * height,
        w: w.w * width,
        h: w.h * height
    }));
}

function spawnParticle() {
    particles.push({
        x: state.emitter.x + (Math.random() - 0.5) * 8,
        y: state.emitter.y + (Math.random() - 0.5) * 8,
        vx: (Math.random() - 0.5) * 0.5,
        vy: 1.5 + Math.random() * 0.5,
        r: 3.5,
        viscosity: 0.98
    });
}

function updatePhysics() {
    // Particle emission
    state.emitter.timer++;
    if (state.emitter.timer % (6 - state.emitter.rate) === 0 && particles.length < 250) {
        spawnParticle();
    }

    // Node wave animation update
    state.nodes.forEach(n => {
        if (n.state !== STATE.NEUTRAL) {
            n.pulse = (n.pulse + 0.04) % (Math.PI * 2);
        }
    });

    // Particle updates
    for (let i = particles.length - 1; i >= 0; i--) {
        let p = particles[i];
        
        // Base Gravity
        let ax = 0;
        let ay = 0.08;
        let localViscosity = 0.97;

        // Apply Magnetic Forces
        state.nodes.forEach(node => {
            if (node.state === STATE.NEUTRAL) return;

            let dx = node.x - p.x;
            let dy = node.y - p.y;
            let distSq = dx * dx + dy * dy;
            let dist = Math.sqrt(distSq);

            if (dist < 220 && dist > 1) {
                // Inverse distance magnetic field force
                let forceMagnitude = (node.state * 1800) / (distSq + 400);
                ax += (dx / dist) * forceMagnitude;
                ay += (dy / dist) * forceMagnitude;

                // High field density alters viscosity (ferrofluid behavior)
                if (dist < node.r * 2.5) {
                    localViscosity = 0.88; // Slows down and hardens near strong magnetic nodes
                }
            }
        });

        p.vx += ax;
        p.vy += ay;
        p.vx *= localViscosity;
        p.vy *= localViscosity;

        p.x += p.vx;
        p.y += p.vy;

        // Wall collisions
        state.walls.forEach(w => {
            if (p.x + p.r > w.x && p.x - p.r < w.x + w.w &&
                p.y + p.r > w.y && p.y - p.r < w.y + w.h) {
                
                // Simple collision normal estimation
                let overlapLeft = (p.x + p.r) - w.x;
                let overlapRight = (w.x + w.w) - (p.x - p.r);
                let overlapTop = (p.y + p.r) - w.y;
                let overlapBottom = (w.y + w.h) - (p.y - p.r);

                let minOverlap = Math.min(overlapLeft, overlapRight, overlapTop, overlapBottom);

                if (minOverlap === overlapTop) { p.y = w.y - p.r; p.vy *= -0.3; }
                else if (minOverlap === overlapBottom) { p.y = w.y + w.h + p.r; p.vy *= -0.3; }
                else if (minOverlap === overlapLeft) { p.x = w.x - p.r; p.vx *= -0.3; }
                else if (minOverlap === overlapRight) { p.x = w.x + w.w + p.r; p.vx *= -0.3; }
            }
        });

        // Screen boundary safety
        if (p.x < 0 || p.x > width || p.y > height) {
            particles.splice(i, 1);
            continue;
        }

        // Receiver trap detection
        let rDx = state.receiver.x - p.x;
        let rDy = state.receiver.y - p.y;
        if (Math.sqrt(rDx * rDx + rDy * rDy) < state.receiver.r) {
            particles.splice(i, 1);
            state.receiver.count = Math.min(state.receiver.required, state.receiver.count + 1);
            
            if (state.receiver.count >= state.receiver.required && !state.completed) {
                state.completed = true;
                setTimeout(() => winModal.classList.add('active'), 300);
            }
        }
    }
}

function render() {
    ctx.clearRect(0, 0, width, height);

    // Background Grid Pattern
    ctx.strokeStyle = "rgba(255,255,255,0.02)";
    ctx.lineWidth = 1;
    const gridSize = 24;
    for (let x = 0; x < width; x += gridSize) {
        ctx.beginPath(); ctx.moveTo(x, 0); ctx.lineTo(x, height); ctx.stroke();
    }
    for (let y = 0; y < height; y += gridSize) {
        ctx.beginPath(); ctx.moveTo(0, y); ctx.lineTo(width, y); ctx.stroke();
    }

    // Render Walls
    state.walls.forEach(w => {
        ctx.fillStyle = "#1e293b";
        ctx.shadowColor = "#000";
        ctx.shadowBlur = 10;
        ctx.beginPath();
        ctx.roundRect(w.x, w.y, w.w, w.h, 4);
        ctx.fill();
        ctx.shadowBlur = 0;

        ctx.strokeStyle = "rgba(255,255,255,0.1)";
        ctx.lineWidth = 1;
        ctx.stroke();
    });

    // Render Receiver Trap
    const rx = state.receiver.x, ry = state.receiver.y, rr = state.receiver.r;
    const fillPercent = state.receiver.count / state.receiver.required;

    ctx.beginPath();
    ctx.arc(rx, ry, rr, 0, Math.PI * 2);
    ctx.fillStyle = "rgba(15, 23, 42, 0.8)";
    ctx.fill();
    ctx.strokeStyle = "rgba(255,255,255,0.15)";
    ctx.lineWidth = 2;
    ctx.stroke();

    // Fill progress ring
    ctx.beginPath();
    ctx.arc(rx, ry, rr, -Math.PI / 2, -Math.PI / 2 + (Math.PI * 2 * fillPercent));
    ctx.strokeStyle = "#00f0ff";
    ctx.lineWidth = 4;
    ctx.shadowColor = "#00f0ff";
    ctx.shadowBlur = 8;
    ctx.stroke();
    ctx.shadowBlur = 0;

    // Receiver Icon
    ctx.fillStyle = "#e2e8f0";
    ctx.font = "bold 11px -apple-system, sans-serif";
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";
    ctx.fillText(`${Math.floor(fillPercent * 100)}%`, rx, ry);

    // Render Magnetic Nodes
    state.nodes.forEach(n => {
        let color = "#334155";
        let glowColor = "transparent";

        if (n.state === STATE.ATTRACT) { color = "#ff2a5f"; glowColor = "rgba(255,42,95,0.4)"; }
        else if (n.state === STATE.REPEL) { color = "#00f0ff"; glowColor = "rgba(0,240,255,0.4)"; }

        // Field pulse rings
        if (n.state !== STATE.NEUTRAL) {
            ctx.beginPath();
            let waveR = n.r + (Math.sin(n.pulse) + 1) * 12;
            ctx.arc(n.x, n.y, waveR, 0, Math.PI * 2);
            ctx.strokeStyle = glowColor;
            ctx.lineWidth = 1.5;
            ctx.stroke();
        }

        // Node base
        ctx.beginPath();
        ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
        ctx.fillStyle = "#0f172a";
        ctx.fill();
        ctx.strokeStyle = color;
        ctx.lineWidth = 3;
        ctx.shadowColor = glowColor;
        ctx.shadowBlur = 12;
        ctx.stroke();
        ctx.shadowBlur = 0;

        // Node Symbol
        ctx.fillStyle = color;
        ctx.font = "bold 16px sans-serif";
        const symbol = n.state === STATE.ATTRACT ? "+" : n.state === STATE.REPEL ? "-" : "OFF";
        ctx.fillText(symbol, n.x, n.y);
    });

    // Render Emitter
    ctx.beginPath();
    ctx.arc(state.emitter.x, state.emitter.y, 8, 0, Math.PI * 2);
    ctx.fillStyle = "#94a3b8";
    ctx.fill();

    // Render Ferrofluid Particles with Fluid Connection Lines
    ctx.fillStyle = "#ffffff";
    for (let i = 0; i < particles.length; i++) {
        let p = particles[i];

        // Particle dot
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fill();

        // Connect nearby particles to simulate ferrofluid liquid density/spikes
        for (let j = i + 1; j < particles.length; j++) {
            let p2 = particles[j];
            let dx = p2.x - p.x;
            let dy = p2.y - p.y;
            let distSq = dx * dx + dy * dy;

            if (distSq < 220) {
                ctx.beginPath();
                ctx.moveTo(p.x, p.y);
                ctx.lineTo(p2.x, p2.y);
                ctx.strokeStyle = `rgba(255, 255, 255, ${1 - distSq / 220})`;
                ctx.lineWidth = p.r * 1.2;
                ctx.stroke();
            }
        }
    }
}

function gameLoop() {
    updatePhysics();
    render();
    animFrameId = requestAnimationFrame(gameLoop);
}

// Controls & Interaction
function handleTap(clientX, clientY) {
    const rect = canvas.getBoundingClientRect();
    const x = clientX - rect.left;
    const y = clientY - rect.top;

    state.nodes.forEach(node => {
        let dx = x - node.x;
        let dy = y - node.y;
        if (Math.sqrt(dx * dx + dy * dy) < node.r + 10) {
            // Cycle through Neutral -> Attract (+) -> Repel (-) -> Neutral
            if (node.state === STATE.NEUTRAL) node.state = STATE.ATTRACT;
            else if (node.state === STATE.ATTRACT) node.state = STATE.REPEL;
            else node.state = STATE.NEUTRAL;
        }
    });
}

canvas.addEventListener('click', (e) => handleTap(e.clientX, e.clientY));
canvas.addEventListener('touchstart', (e) => {
    if (e.touches.length > 0) {
        handleTap(e.touches[0].clientX, e.touches[0].clientY);
    }
}, { passive: true });

resetBtn.addEventListener('click', () => loadLevel(currentLevelIdx));
nextBtn.addEventListener('click', () => {
    currentLevelIdx = (currentLevelIdx + 1) % LEVELS.length;
    loadLevel(currentLevelIdx);
});

// Initialization
window.addEventListener('resize', resize);
resize();
gameLoop();
</script>
</body>
</html>
